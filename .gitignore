*charts/

# infra
infra/**/terraform.tfstate*
infra/**/terraform.tfvars
infra/**/.terraform/
infra/**/homelab-ca.yml

# per-VM compose secrets (see infra/olympus/services/*/.env.example)
infra/**/.env
!infra/**/.env.example
infra/**/*.asc

# per-VM runtime state / certs — created on the VM, never committed
infra/**/data/
infra/**/certs/
infra/**/secrets/

# vault-agent per-VM material (bootstrap creds + fetched CA + token sink)
infra/**/vault-agent/role_id
infra/**/vault-agent/secret_id
infra/**/vault-agent/ca.crt
infra/**/vault-agent/.vault-token
infra/**/vault-agent/pidfile

# local credentials shared by Claude Code and Codex (not a VM secret)
.agents/secrets/*
!.agents/secrets/*.example
!.agents/secrets/.gitkeep
.claude/secrets/*
!.claude/secrets/*.example
!.claude/secrets/.gitkeep

# secrets
.env
