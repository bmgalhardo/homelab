LOG_LEVEL=INFO
WINDOW_HOURS=48
MAX_LOG_CLUSTERS=100
# CONTEXT_DIR and CA_FILE are set by docker-compose.yml; set them when running with uv
CONTEXT_DIR=../.agents/context
CONTEXT_EXCLUDE=deployment.md
CA_FILE=../infra/ca/root-ca.crt

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
ANTHROPIC_BATCH=true
BATCH_TIMEOUT_MINUTES=360

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# collectors: leave a block empty to disable it
LOKI_URL=http://athena.bgalhardo.internal:3100
LOKI_LIMIT=20000
PROMETHEUS_URL=http://athena.bgalhardo.internal:9090

# on athena the two secrets below come from Vault (../athena/secrets/argus.env)
PROXMOX_API_HOST=https://proxmox.bgalhardo.internal
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=

OMNI_ENDPOINT=https://omni.bgalhardo.internal:443
OMNI_SERVICE_ACCOUNT_KEY=
OMNI_CLUSTER=elysium
