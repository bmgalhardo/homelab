LOG_LEVEL=INFO
WINDOW_HOURS=48
MAX_LOG_CLUSTERS=100
# Documentation for the judge. docker-compose.yml sets the URLs, the cache and CA_FILE;
# set them here when running with uv. CONTEXT_DIR reads local *.md instead (or as well).
# CONTEXT_TOKEN is sent only to CONTEXT_PRIVATE_URLS; on athena it comes from Vault.
# A URL that can't be fetched falls back to its cached copy (context_unreachable fact).
# CONTEXT_DIR=../.agents/context
# CONTEXT_EXCLUDE=deployment.md
CONTEXT_URLS=
CONTEXT_PRIVATE_URLS=
CONTEXT_TOKEN=
CONTEXT_CACHE_DIR=.cache/context
CA_FILE=../infra/ca/root-ca.crt

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
ANTHROPIC_BATCH=true
BATCH_TIMEOUT_MINUTES=360

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# collectors: leave a block empty to disable it
LOKI_URL=http://athena.bgalhardo.internal:3100
LOKI_LIMIT=20000
PROMETHEUS_URL=http://athena.bgalhardo.internal:9090

# on athena the two secrets below come from Vault (../athena/secrets/argus.env)
PROXMOX_API_HOST=https://proxmox.bgalhardo.internal
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=

OMNI_ENDPOINT=https://omni.bgalhardo.internal:443
OMNI_SERVICE_ACCOUNT_KEY=
OMNI_CLUSTER=elysium

# Home Assistant: battery sensors (device_class battery, %) below HA_BATTERY_LOW
# or not reporting. HA_BATTERY_EXCLUDE is a regex on entity_id.
# On athena HA_TOKEN comes from Vault (../athena/secrets/argus.env)
HA_URL=https://home.bgalhardo.internal
HA_TOKEN=
HA_BATTERY_LOW=20
HA_BATTERY_EXCLUDE=phone
