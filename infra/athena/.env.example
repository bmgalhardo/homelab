# Copy to .env on athena. Non-secret Grafana defaults only.
#
# The real admin credentials come from Vault (kv/athena) via vault-agent,
# rendered to ./secrets/grafana.env which Grafana also reads. That file
# wins — these are just the values used on the very first boot before
# vault-agent has authenticated.

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme
