{
  "uid": "athena-containers",
  "title": "Containers",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "tags": [],
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "table",
      "title": "Now",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (name) (container_memory_working_set_bytes{job=\"cadvisor-athena\", name!=\"\"})",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (name) (container_spec_memory_limit_bytes{job=\"cadvisor-athena\", name!=\"\"})",
          "refId": "B",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (name) (container_memory_working_set_bytes{job=\"cadvisor-athena\", name!=\"\"}) / max by (name) (container_spec_memory_limit_bytes{job=\"cadvisor-athena\", name!=\"\"} > 0)",
          "refId": "C",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{job=\"cadvisor-athena\", name!=\"\"}[5m]))",
          "refId": "D",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (name) (rate(container_fs_reads_bytes_total{job=\"cadvisor-athena\", name!=\"\"}[5m]))",
          "refId": "E",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (name) (increase(container_memory_events_max_total{job=\"cadvisor-athena\", name!=\"\"}[1h]))",
          "refId": "F",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (name) (increase(container_oom_events_total{job=\"cadvisor-athena\", name!=\"\"}[24h]))",
          "refId": "G",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "name": "container",
              "Value #A": "memory",
              "Value #B": "limit",
              "Value #C": "% of limit",
              "Value #D": "CPU (cores)",
              "Value #E": "disk reads/s",
              "Value #F": "limit hits (1h)",
              "Value #G": "OOM kills (24h)"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
