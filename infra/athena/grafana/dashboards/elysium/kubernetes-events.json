{
  "uid": "elysium-events",
  "title": "Kubernetes events",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "tags": [],
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "label": "Namespace",
        "query": {
          "label": "namespace",
          "stream": "{cluster=\"elysium\", job=\"k8s-events\"}",
          "type": 1
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "allValue": ".+"
      },
      {
        "name": "type",
        "type": "custom",
        "label": "Type",
        "query": "Warning,Normal",
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "text": [
            "Warning"
          ],
          "value": [
            "Warning"
          ]
        },
        "options": []
      },
      {
        "name": "kind",
        "type": "custom",
        "label": "Kind",
        "query": "Pod,Deployment,ReplicaSet,StatefulSet,DaemonSet,Job,Node,PersistentVolumeClaim,HelmRelease,Kustomization,GitRepository,HelmRepository,VaultStaticSecret,Certificate",
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "reason",
        "type": "textbox",
        "label": "Reason contains",
        "current": {
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Events / 5m by reason",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (reason) (count_over_time({cluster=\"elysium\", job=\"k8s-events\", namespace=~\"$namespace\"} | logfmt | type=~\"$type\" | kind=~\"$kind\" | reason=~\"(?i).*$reason.*\" [5m]))",
          "refId": "A",
          "legendFormat": "{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Events / 5m by namespace",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (namespace) (count_over_time({cluster=\"elysium\", job=\"k8s-events\", namespace=~\"$namespace\"} | logfmt | type=~\"$type\" | kind=~\"$kind\" | reason=~\"(?i).*$reason.*\" [5m]))",
          "refId": "A",
          "legendFormat": "{{namespace}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 2
    },
    {
      "type": "logs",
      "title": "Events",
      "gridPos": {
        "h": 20,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{cluster=\"elysium\", job=\"k8s-events\", namespace=~\"$namespace\"} | logfmt | type=~\"$type\" | kind=~\"$kind\" | reason=~\"(?i).*$reason.*\" | line_format \"{{.type}}  {{.reason}}  {{.kind}}/{{.name}}  ({{.count}}x)  {{.msg}}\"",
          "refId": "A",
          "legendFormat": ""
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "id": 3
    }
  ],
  "annotations": {
    "list": []
  }
}