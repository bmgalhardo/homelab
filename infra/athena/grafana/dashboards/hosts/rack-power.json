    {
      "id": 11,
      "type": "state-timeline",
      "title": "Outlets",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
