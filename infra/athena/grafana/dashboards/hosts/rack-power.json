          "expr": "clamp_min(sum(hass_sensor_power_w{friendly_name=\"Homelab Monitor Active Power\"}) - (sum(hass_sensor_power_w{friendly_name=\"Apollo Plug Active Power\"}) or vector(0)) - (sum(hass_sensor_power_w{friendly_name=\"Hades Plug Active Power\"}) or vector(0)), 0)",
