        "w": 7,
        "h": 2
      },
      "options": {
        "mode": "markdown",
        "content": "### Rack \u2014 top to bottom\nShelly Mini PM on the rack feed; Shelly plugs on Apollo and Hades."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Rack feed (Shelly Mini PM)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 7,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(hass_sensor_power_w{friendly_name=\"Homelab Monitor Active Power\"})",
          "legendFormat": "Rack feed (Shelly Mini PM)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "#f2b134"
          },
          "noValue": "off"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
