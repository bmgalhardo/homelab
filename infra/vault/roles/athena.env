# athena — logging/metrics node (Pi4). Reads its Grafana admin creds and the
# UniFi API key (`unifi_api_key`, added by hand) from KV, and issues its own
# TLS leaf for Grafana.
ROLE=athena
COMMON_NAME=athena.bgalhardo.internal
KV_PATH=kv/data/athena
KV_SEED="grafana_admin_user=admin grafana_admin_password=@random"
DEPLOY_DIR=/root/athena
